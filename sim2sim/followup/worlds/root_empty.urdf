<robot name="merge_probe"><link name="root"><inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial><collision><geometry><box size="0.05 0.05 0.05"/></geometry></collision></link><link name="attach"></link><link name="bracket"><inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial><collision><geometry><box size="0.05 0.05 0.05"/></geometry></collision></link><link name="arm"><inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial><collision><geometry><box size="0.05 0.05 0.05"/></geometry></collision></link><joint name="j_attach" type="fixed"><parent link="root"/><child link="attach"/><origin xyz="0 0 0.15"/><axis xyz="0 0 1"/></joint><joint name="j_bracket" type="fixed"><parent link="attach"/><child link="bracket"/><origin xyz="0 0 0.15"/><axis xyz="0 0 1"/></joint><joint name="j_arm" type="revolute"><parent link="bracket"/><child link="arm"/><origin xyz="0 0 0.15"/><axis xyz="0 0 1"/><limit lower="-2" upper="2" effort="100" velocity="2"/></joint></robot>
