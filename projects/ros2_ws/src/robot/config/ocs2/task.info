; OCS2 task configuration for R1 dual-arm robot (parking mode, fixed base)
; Arms: 2x RM-75 7-DOF -> 14 total arm DOFs
; Base: fixed (waist/body joints removed from planning)

model_information
{
  ; 0 = defaultManipulator (fixed-base arm, no mobile base)
  manipulatorModelType    0

  ; Joints to exclude from OCS2 planning.
  ; Fixed joints are excluded automatically; list the non-fixed joints to ignore.
  removeJoints
  {
    ; Torso (fixed in parking mode)
    [0]  "waist_joint"
    [1]  "body_joint"

    ; Head
    [2]  "head_camera_joint"

    ; Drive wheels
    [3]  "wheel_L_joint"
    [4]  "wheel_R_joint"

    ; Caster wheels
    [5]  "caster_LF_joint"
    [6]  "caster_RF_joint"
    [7]  "caster_LB_joint"
    [8]  "caster_RB_joint"

    ; Grippers (discrete, controlled separately)
    [9]  "left_PGIA_joint1"
    [10] "left_PGIA_joint2"
    [11] "right_PGIA_joint1"
    [12] "right_PGIA_joint2"
  }

  ; Root frame of the kinematic chain
  baseFrame                   "base_link"

  ; End-effector frames for dual-arm planning
  eeFrame                     "left_flange_link"
  eeFrame1                    "right_flange_link"
}

model_settings
{
  usePreComputation           true
  recompileLibraries          true
}

ddp
{
  algorithm                   SLQ
  nThreads                    3
  threadPriority              50
  maxNumIterations            1
  minRelCost                  0.1
  constraintTolerance         1e-3
  displayInfo                 false
  displayShortSummary         false
  checkNumericalStability     false
  debugPrintRollout           false
  debugCaching                false
  AbsTolODE                   1e-5
  RelTolODE                   1e-3
  maxNumStepsPerSecond        100000
  timeStep                    1e-3
  backwardPassIntegratorType  ODE45
  constraintPenaltyInitialValue   20.0
  constraintPenaltyIncreaseRate   2.0
  preComputeRiccatiTerms      true
  useFeedbackPolicy           false
  strategy                    LINE_SEARCH
  lineSearch
  {
    minStepLength             1e-2
    maxStepLength             1.0
    hessianCorrectionStrategy DIAGONAL_SHIFT
    hessianCorrectionMultiple 1e-3
  }
}

rollout
{
  AbsTolODE                   1e-5
  RelTolODE                   1e-3
  timeStep                    1e-2
  integratorType              ODE45
  maxNumStepsPerSecond        100000
  checkNumericalStability     false
}

mpc
{
  timeHorizon                 1.0
  solutionTimeWindow          0.2
  coldStart                   false
  debugPrint                  false
  mpcDesiredFrequency         50
  mrtDesiredFrequency         200
}

initialState
{
  arm
  {
    (0,0)   0.0
    (1,0)   0.0
    (2,0)   0.0
    (3,0)   0.0
    (4,0)   0.0
    (5,0)   0.0
    (6,0)   0.0
    (7,0)   0.0
    (8,0)   0.0
    (9,0)   0.0
    (10,0)  0.0
    (11,0)  0.0
    (12,0)  0.0
    (13,0)  0.0
  }
}

stateCost
{
  ; Fixed nominal joint preference is disabled for normal teaching. A fixed nominal
  ; is useful only as a temporary diagnostic because it remains active throughout
  ; the whole OCS2 motion and can fight arm opening / handoff postures.
  activate false

  Q
  {
    arm
    {
      scaling 1.0
      ; inactive legacy diagnostic weights; kept only for quick temporary stateCost tests.
      (0,0)   0.8
      (1,1)   1.5
      (2,2)   1.5
      (3,3)   0.3
      (4,4)   0.05
      (5,5)   0.0
      (6,6)   0.05
      ; inactive legacy right-arm static weights.
      (7,7)   0.0
      (8,8)   0.0
      (9,9)   0.0
      (10,10) 0.0
      (11,11) 0.0
      (12,12) 0.0
      (13,13) 0.0
    }
  }

  nominalState
  {
    arm
    {
      ; left_joint1..left_joint7: measured correct teaching pose.
      (0,0)   -1.57086253166
      (1,0)    1.57073485851
      (2,0)   -1.57081544399
      (3,0)    1.5704407692
      (4,0)    4.17368974013e-05
      (5,0)    1.56915736198
      (6,0)   -4.12942608818e-05
      ; right_joint1..right_joint7: existing normal home pose.
      (7,0)    1.571
      (8,0)    1.571
      (9,0)   -1.5708
      (10,0)  -1.5702
      (11,0)   0.0
      (12,0)  -1.5677
      (13,0)   3.1416
    }
  }
}

dynamicNullspaceCost
{
  ; Dynamic joint-space regularization. q_ref is refreshed by the OCS2 controller:
  ; 1) current measured joints when entering OCS2/reset, and
  ; 2) optionally the latest valid MPC action / filtered policy state each control tick.
  ; Default follows valid MPC output to preserve teleoperation responsiveness.
  activate true
  updateReferenceFromPolicy true

  Q
  {
    arm
    {
      scaling 1.0
      ; left_joint1..7: keep shoulder/elbow stable, keep wrist joints movable.
      (0,0)   0.8
      (1,1)   3.0
      (2,2)   3.0
      (3,3)   0.8
      (4,4)   1.2
      (5,5)   0.6
      (6,6)   1.2
      ; right_joint1..7: symmetric low/medium damping; no static right-arm lock.
      (7,7)   0.5
      (8,8)   1.0
      (9,9)   1.0
      (10,10) 0.4
      (11,11) 0.6
      (12,12) 0.3
      (13,13) 0.6
    }
  }
}

inputCost
{
  R
  {
    arm
    {
      scaling 1e-3
      ; Input regularization damps fast joint velocity. Null-space drift is handled by
      ; dynamicNullspaceCost above. Joint order: left_joint1..left_joint7 map to 0..6.
      (0,0)   10.0
      (1,1)   8.0
      (2,2)   8.0
      (3,3)   3.0
      (4,4)   8.0
      (5,5)   2.0
      (6,6)   8.0
      ; Right arm input regularization damps fast joint velocity.
      ; Joint order: right_joint1..right_joint7 map to indices 7..13.
      (7,7)   10.0
      (8,8)   2.0
      (9,9)   2.0
      (10,10) 3.0
      (11,11) 1.0
      (12,12) 1.0
      (13,13) 1.0
    }
  }
}

; Tracking weights prioritise commanded tool pose over the joint-limit barrier.
; Validated with bounded SIM1 keyboard motions; keep joint limits enabled.
endEffector
{
  dualArmMode                 true
  leftArm
  {
    muPosition                1000.0
    muOrientation              100.0
  }
  rightArm
  {
    muPosition                1000.0
    muOrientation              100.0
  }
}

finalEndEffector
{
  dualArmMode                 true
  leftArm
  {
    muPosition                1000.0
    muOrientation              100.0
  }
  rightArm
  {
    muPosition                1000.0
    muOrientation              100.0
  }
}

jointPositionLimits
{
  activate  true
  mu        0.1
  delta     1e-2
}

jointVelocityLimits
{
  mu      0.01
  delta   1e-3

  lowerBound
  {
    arm
    {
      (0,0)   -1.5708
      (1,0)   -1.5708
      (2,0)   -1.5708
      (3,0)   -1.5708
      (4,0)   -1.5708
      (5,0)   -1.5708
      (6,0)   -1.5708
      (7,0)   -1.5708
      (8,0)   -1.5708
      (9,0)   -1.5708
      (10,0)  -1.5708
      (11,0)  -1.5708
      (12,0)  -1.5708
      (13,0)  -1.5708
    }
  }

  upperBound
  {
    arm
    {
      (0,0)   1.5708
      (1,0)   1.5708
      (2,0)   1.5708
      (3,0)   1.5708
      (4,0)   1.5708
      (5,0)   1.5708
      (6,0)   1.5708
      (7,0)   1.5708
      (8,0)   1.5708
      (9,0)   1.5708
      (10,0)  1.5708
      (11,0)  1.5708
      (12,0)  1.5708
      (13,0)  1.5708
    }
  }
}

selfCollision
{
  activate  false

  collisionObjectPairs {}

  ; Key cross-arm pairs to enable later:
  ; [0] "left_Link5, right_Link5"
  ; [1] "left_Link6, right_Link6"
  ; [2] "left_Link7, right_Link7"
  ; [3] "left_Link4, right_Link4"
  collisionLinkPairs {}

  minimumDistance    0.05
  activationDistance 0.15
  mu                 1e-2
  delta              1e-4
}
