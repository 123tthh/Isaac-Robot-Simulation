            <parent
                link="${parent}" />
            <child
                link="${prefix}body_link" />
            <axis
                xyz="0 1 0" />
            <limit
                lower="0"
                upper="1.5708"
                effort="0"
                velocity="0" />
        </joint>
    </xacro:macro>
</robot>