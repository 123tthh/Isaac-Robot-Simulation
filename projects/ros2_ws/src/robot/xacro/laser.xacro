<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="laser">
    <xacro:macro name="laser" params="prefix:='' parent *origin">
        <link name="${prefix}laser_link">
            <inertial>
            <origin
                xyz="5.6204810290339E-06 -6.1559146155632E-05 -0.0170412894477803"
                rpy="0 0 0" />
            <mass
                value="0.0267727327335854" />
            <inertia
                ixx="1.01468736270547E-05"
                ixy="-2.60698880259647E-09"
                ixz="8.5883669792705E-09"
                iyy="1.00020209167975E-05"
                iyz="-5.77565572410757E-14"
                izz="1.60681535753212E-05" />
            </inertial>
            <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                filename="package://r1_description/meshes/laser_link.STL" />
            </geometry>
            <material
                name="">
                <color
                rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
            </material>
            </visual>
            <collision>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                filename="package://r1_description/meshes/laser_link.STL" />
            </geometry>
            </collision>
        </link>
        
        <joint name="${prefix}laser_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${prefix}laser_link" />
        </joint>
    </xacro:macro>
</robot>