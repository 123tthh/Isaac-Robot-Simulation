<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="r1">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import r1 urdf file -->
    <xacro:include filename="$(find r1_robot_description)/xacro/r1.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="r1.ros2_control.xacro" />


    <xacro:r1_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
