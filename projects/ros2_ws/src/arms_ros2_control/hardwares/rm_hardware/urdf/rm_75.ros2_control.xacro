<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- Simple RM-75 ROS2 Control Macro for MoveIt2 compatibility -->
    <xacro:macro name="rm_75_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
        <xacro:property name="PI" value="3.14159265359"/>
        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- Hardware plugin selection -->
                <plugin>rm_hardware/RMRos2ControlHardware</plugin>
                <param name="arm_dof">7</param>
                <param name="follow">false</param>
                <param name="robot_ip">192.168.1.18</param>
                <param name="robot_port">8080</param>
                <param name="command_timeout">0.5</param>
                <param name="publish_rate">200.0</param>
            </hardware>
            <!-- Joint 1 -->
            <joint name="joint1">
                <command_interface name="position">
                    <param name="min">-3.10668</param>
                    <param name="max">3.10668</param>
                    <param name="initial_value">${initial_positions['joint1']}</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint1']}</param>
                </state_interface>
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
            
            <!-- Joint 2 -->
            <joint name="joint2">
                <command_interface name="position">
                    <param name="min">-2.26892</param>
                    <param name="max">2.26892</param>
                    <param name="initial_value">${initial_positions['joint2']}</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint2']}</param>
                </state_interface>
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
            
            <!-- Joint 3 -->
            <joint name="joint3">
                <command_interface name="position">
                    <param name="min">-3.10668</param>
                    <param name="max">3.10668</param>
                    <param name="initial_value">${initial_positions['joint3']}</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint3']}</param>
                </state_interface>
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
            
            <!-- Joint 4 -->
            <joint name="joint4">
                <command_interface name="position">
                    <param name="min">-2.35619</param>
                    <param name="max">2.35619</param>
                    <param name="initial_value">${initial_positions['joint4']}</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint4']}</param>
                </state_interface>
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
            
            <!-- Joint 5 -->
            <joint name="joint5">
                <command_interface name="position">
                    <param name="min">-3.10668</param>
                    <param name="max">3.10668</param>
                    <param name="initial_value">${initial_positions['joint5']}</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint5']}</param>
                </state_interface>
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
            
            <!-- Joint 6 -->
            <joint name="joint6">
                <command_interface name="position">
                    <param name="min">-2.23402</param>
                    <param name="max">2.23402</param>
                    <param name="initial_value">${initial_positions['joint6']}</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint6']}</param>
                </state_interface>
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
            
            <!-- Joint 7 -->
            <joint name="joint7">
                <command_interface name="position">
                    <param name="min">-3.10668</param>
                    <param name="max">3.10668</param>
                    <param name="initial_value">${initial_positions['joint7']}</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint7']}</param>
                </state_interface>
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>

            
            
        </ros2_control>
    </xacro:macro>

</robot>
